    "layout": { "type": "string", "default": "columns" },
    "buttonText": { "type": "string", "default": "" },
    "buttonBg": { "type": "string", "default": "" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  }
}
